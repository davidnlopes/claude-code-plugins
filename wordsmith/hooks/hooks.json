{
  "description": "Suggest loading the comment-discipline and document-discipline skills at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/suggest-writing-skills.sh"
          }
        ]
      }
    ]
  }
}
